{
  "name": "chapter-generic",
  "label": "通用章节教案模板",
  "source": "通用章节结构；复制后按学校模板修改，不包含任何学校或教师个人信息",
  "version": "2.0",
  "cover": {
    "title_template": "{course_name}教案",
    "semester": "",
    "fields": [
      { "label": "学院（部）", "value": "{college}", "fallback": "—" },
      { "label": "教研室（系）", "value": "{department}", "fallback": "—" },
      { "label": "授课班级", "value": "{class_name}", "fallback": "—" },
      { "label": "课程学分", "value": "{credits}", "fallback": "—" },
      { "label": "课程学时", "value": "{total_hours}", "fallback": "—" },
      { "label": "课程周学时", "value": "{weekly_hours}", "fallback": "—" },
      { "label": "任课教师", "value": "{teacher}", "fallback": "—" }
    ],
    "note": "使用说明：将本文件复制为学校或个人的风格配置，按实际情况填写字段；通过 --style-config 传入。"
  },
  "chapter": {
    "head_template": "第{chapter_num}章",
    "title_field": "章标题",
    "field_order": [
      "课时",
      "教学方法",
      "教学目的及要求",
      "教学环境",
      "重点",
      "难点",
      "讲授内容",
      "思考题和作业",
      "参考文献"
    ],
    "defaults": {
      "教学环境": "多媒体教室",
      "教学方法": ["讲授法", "案例教学", "其他"],
      "参考文献": ""
    }
  },
  "content_style": {
    "purpose_requirements": "目的：{objectives_merged}。要求：{requirements_merged}。",
    "key_points_prefix": "重点：",
    "difficult_prefix": "难点：",
    "teaching_content_sections": "按课中环节重组为第一节/第二节/第三节…，节内为编号列表",
    "homework_label": "思考题和作业",
    "reflection_not_in_template": "教学反思不在原始模板中，作为附加节输出"
  }
}
